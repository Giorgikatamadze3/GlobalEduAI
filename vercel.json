{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "regions": [
    "fra1"
  ],
  "buildCommand": "npm run build",
  "functions": {
    "app.js": {
      "maxDuration": 60,
      "includeFiles": "{Server/data/*.json,Server/*-schema.sql,index.html,*.css,*.js}"
    }
  },
  "crons": [{"path":"/api/billing/cron","schedule":"0 3 * * *"}],
  "headers": [
    {
      "source": "/catalog.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
