# Local server
PORT=3000
NODE_ENV=development

# Persistent local accounts. Relative paths are resolved from Server/.
# SQLite is the supported driver; Node.js 24+ is required.
AUTH_DB_DRIVER=sqlite
AUTH_DB_PATH=data/accounts.sqlite

# Vercel: use persistent Postgres from Marketplace (e.g. Neon).
# Set AUTH_DB_DRIVER=postgres and DATABASE_URL in Vercel Environment Variables.
# Use your provider's pooled TLS URL. Never commit its value.
DATABASE_URL=

# Content CMS: local SQLite is separate from account storage.
# Production uses DATABASE_URL, but HTTP reads never create tables.
CMS_DB_PATH=
# Explicit account UUIDs; public registration cannot grant admin access.
ADMIN_ACCOUNT_IDS=
# Optional one-time pre-existing-account grant, set server-side only:
# ADMIN_BOOTSTRAP={"email":"owner@example.com","createdBefore":"2026-11-02T18:00:00Z"}
# DIRECT connection URL of a disposable branch cloned from production.
# Run npm run content:test-branch; never commit or share this URL.
CONTENT_TEST_DATABASE_URL=
# Set in Vercel only after the branch test passes, to the exact schemaHash.
CONTENT_MIGRATION_TESTED_SHA=

# Conversational AI advisor: server-only key; never put it in browser JavaScript.
# Leave empty to keep chat unavailable while local profile matching still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional email delivery (not required for registration or login)
EMAIL_USER=your-email@example.com
EMAIL_PASS=replace-with-your-mail-app-password
ENABLE_APPLICATION_EMAIL=false

# Optional catalog persistence via `node Server/seed.js --write` only.
# The web server does not use MongoDB for accounts or catalog discovery.
MONGO_URI=mongodb://127.0.0.1:27017/globaledu

# Packages, activity, subscriptions and payment ledger. Local SQLite only:
BILLING_DB_PATH=
# Direct disposable production-clone branch; falls back to CONTENT_TEST_DATABASE_URL.
BILLING_TEST_DATABASE_URL=
# One-time Vercel build migration gate, exact successful branch schema hash.
BILLING_MIGRATION_TESTED_SHA=
BILLING_PUBLIC_ORIGIN=https://globaleduai.vercel.app
# Bank of Georgia Payment Manager. Keep disabled until a merchant account exists.
BOG_PAYMENTS_ENABLED=false
BOG_ENVIRONMENT=sandbox
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# Enable live mode only after real sandbox end-to-end verification and merchant approval.
BOG_LIVE_VERIFIED=false
# Optional saved-card automatic charges require separate merchant approval and user consent.
BOG_RECURRING_ENABLED=false
# Vercel cron Authorization token; never expose it to the browser.
CRON_SECRET=
