# Local server
PORT=3000
NODE_ENV=development

# Persistent local accounts. Relative paths are resolved from Server/.
# SQLite is the supported driver; Node.js 24+ is required.
AUTH_DB_DRIVER=sqlite
AUTH_DB_PATH=data/accounts.sqlite

# Vercel: use persistent Postgres from Marketplace (e.g. Neon).
# Set AUTH_DB_DRIVER=postgres and DATABASE_URL in Vercel Environment Variables.
# Use your provider's pooled TLS URL. Never commit its value.
DATABASE_URL=

# Conversational AI advisor: server-only key; never put it in browser JavaScript.
# Leave empty to keep chat unavailable while local profile matching still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional email delivery (not required for registration or login)
EMAIL_USER=your-email@example.com
EMAIL_PASS=replace-with-your-mail-app-password
ENABLE_APPLICATION_EMAIL=false

# Optional catalog persistence via `node Server/seed.js --write` only.
# The web server does not use MongoDB for accounts or catalog discovery.
MONGO_URI=mongodb://127.0.0.1:27017/globaledu
